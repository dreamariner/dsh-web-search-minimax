{
  "name": "@dreamariner/dsh-web-search-minimax",
  "description": "DeepSeek Harness 的 MiniMax 联网搜索 provider：走 MiniMax Coding Plan 搜索接口，密钥与 DSH 模型配置中的 MiniMax 提供商共用（国内 / 国际版 region 切换）",
  "version": "0.1.3",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.client.config.ts",
    "dev": "tsdown --watch",
    "dev:hmr": "dsh-ctl dev-hmr",
    "prepare": "tsdown && tsdown --config tsdown.client.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "profile:add": "dsh-ctl profile-add",
    "dsh:start": "dsh-ctl start",
    "dsh:restart": "dsh-ctl restart",
    "dsh:stop": "dsh-ctl stop",
    "dsh:status": "dsh-ctl status",
    "dsh:probe": "dsh-ctl probe"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "web-search",
    "minimax",
    "search-provider"
  ],
  "author": "Jianan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreamariner/dsh-web-search-minimax"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-web": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.19.0 <4.0.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-web": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@dreamariner/dsh-ctl": "link:../create-dsh-plugin/packages/dsh-ctl",
    "@types/node": "^24",
    "@types/react": "^18.2.0",
    "js-yaml": "^4.1.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9",
    "vitest": "^5.0.3"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [],
      "external": []
    }
  },
  "packageManager": "pnpm@11.7.0",
  "dshVersion": "0.2.2-rc.5",
  "homepage": "https://github.com/dreamariner/dsh-web-search-minimax"
}
